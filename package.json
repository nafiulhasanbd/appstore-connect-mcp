{
  "name": "appstore-connect-mcp",
  "version": "1.3.0",
  "description": "MCP server for Apple App Store Connect — manage apps, builds, TestFlight, reviews, and sales reports directly from Claude",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "appstore-connect-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --shims",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "claude",
    "model-context-protocol",
    "app-store-connect",
    "apple",
    "ios",
    "testflight",
    "appstore"
  ],
  "author": "Nafiul Hasan <nafiulhasanbd@gmail.com> (Pointerflow LLC)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pointerflow/appstore-connect-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/pointerflow/appstore-connect-mcp/issues"
  },
  "homepage": "https://github.com/pointerflow/appstore-connect-mcp#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.9",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
