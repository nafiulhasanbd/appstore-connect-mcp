# Apple App Store Connect API credentials
# Generate at: https://appstoreconnect.apple.com/access/integrations/api

# Your Key ID (10 chars, e.g. ABC1234DEF)
APP_STORE_CONNECT_KEY_ID=your_key_id_here

# Your Issuer ID (UUID format)
APP_STORE_CONNECT_ISSUER_ID=00000000-0000-0000-0000-000000000000

# Path to your downloaded .p8 private key file
# Example: /Users/you/keys/AuthKey_ABC1234DEF.p8
APP_STORE_CONNECT_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_KEYID.p8

# OR pass the key contents directly (mutually exclusive with PATH)
# APP_STORE_CONNECT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"

# Optional overrides
# APP_STORE_CONNECT_BASE_URL=https://api.appstoreconnect.apple.com
# APP_STORE_CONNECT_TIMEOUT_MS=30000
